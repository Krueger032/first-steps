// Единая нормализация canonical для индексируемых HTML-страниц
AddEventHandler('main', 'OnEndBufferContent', 'santehpodborNormalizeCanonical');

function santehpodborNormalizeCanonical(&$content)
{
    if (
        (defined('ADMIN_SECTION') && ADMIN_SECTION === true)
        || PHP_SAPI === 'cli'
        || !is_string($content)
        || stripos($content, '<html') === false
        || stripos($content, '</head>') === false
    ) {
        return;
    }

    // Удаляем canonical, добавленные компонентами и шаблонами
    $content = preg_replace(
        array(
            '~<link\\b[^>]*\\brel\\s*=\\s*(["\\x27])[^"\\x27]*\\bcanonical\\b[^"\\x27]*\\1[^>]*>\\s*~i',
            '~<link\\b[^>]*\\brel\\s*=\\s*canonical\\b[^>]*>\\s*~i',
        ),
        '',
        $content
    );

    $statusCode = http_response_code();
    if (
        ($statusCode !== false && (int)$statusCode !== 200)
        || (defined('ERROR_404') && ERROR_404 === 'Y')
    ) {
        return;
    }

    global $APPLICATION;

    $robots = '';
    $noindex = '';
    if (is_object($APPLICATION) && $APPLICATION instanceof CMain) {
        $robots = (string)$APPLICATION->GetPageProperty('robots');
        $noindex = (string)$APPLICATION->GetPageProperty('noindex');
    }

    if (
        stripos($robots, 'noindex') !== false
        || strtoupper($noindex) === 'Y'
        || preg_match(
            '~<meta\\b[^>]*\\bname\\s*=\\s*(["\\x27])robots\\1[^>]*\\bcontent\\s*=\\s*(["\\x27])[^"\\x27]*noindex[^"\\x27]*\\2[^>]*>~i',
            $content
        )
        || preg_match(
            '~<meta\\b[^>]*\\bcontent\\s*=\\s*(["\\x27])[^"\\x27]*noindex[^"\\x27]*\\1[^>]*\\bname\\s*=\\s*(["\\x27])robots\\2[^>]*>~i',
            $content
        )
    ) {
        return;
    }

    $requestUri = (string)($_SERVER['REQUEST_URI'] ?? '/');
    $path = parse_url($requestUri, PHP_URL_PATH);
    if (!is_string($path) || $path === '') {
        $path = '/';
    }

    $path = preg_replace('~/+~', '/', $path);
    $path = strtolower($path);
    $path = preg_replace_callback(
        '/%[0-9a-f]{2}/i',
        static function (array $match): string {
            return strtoupper($match[0]);
        },
        $path
    );
    $path = preg_replace('~/index\\.php$~i', '/', $path);

    if ($path !== '/' && !preg_match('~/[^/]+\\.[a-z0-9]{1,8}$~i', $path)) {
        $path = rtrim($path, '/') . '/';
    }

    if (
        preg_match(
            '~^/(bitrix|ajax|auth|personal|search|include|upload|local|desktop_app|cgi-bin|test|catalog-test|updater|exform|exform1)(/|$)~i',
            $path
        )
    ) {
        return;
    }

    $canonicalParams = array();
    $query = parse_url($requestUri, PHP_URL_QUERY);
    if (is_string($query) && $query !== '') {
        parse_str($query, $queryParams);
        foreach ($queryParams as $name => $value) {
            if (
                preg_match('/^PAGEN_\\d+$/i', (string)$name)
                && is_scalar($value)
                && ctype_digit((string)$value)
                && (int)$value > 1
            ) {
                $canonicalParams[$name] = (string)$value;
            }
        }
    }

    $canonical = 'https://santehpodbor.ru' . $path;
    if ($canonicalParams) {
        ksort($canonicalParams);
        $canonical .= '?' . http_build_query($canonicalParams, '', '&', PHP_QUERY_RFC3986);
    }

    $canonicalTag = '<link rel="canonical" href="'
        . htmlspecialchars($canonical, ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8')
        . '">' . PHP_EOL;

    $content = preg_replace(
        '~</head>~i',
        $canonicalTag . '</head>',
        $content,
        1
    );
}

// LCP: return marked priority images to the initial HTML after Enext lazy-load rewriting
if (!function_exists('santehpodborRestorePriorityImages')) {
    function santehpodborRestorePriorityImages(&$content)
    {
        if (!is_string($content) || stripos($content, 'data-lcp-image') === false) {
            return;
        }

        $content = preg_replace_callback(
            '~<img\b[^>]*\bdata-lcp-image(?:=(["\x27]).*?\1)?[^>]*>~is',
            static function (array $matches) {
                $tag = $matches[0];

                if (preg_match('~\sdata-lazyload-src=(["\x27])(.*?)\1~is', $tag)) {
                    $tag = preg_replace('~\ssrc=(["\x27]).*?\1~is', '', $tag);
                    $tag = preg_replace('~\sdata-lazyload-src=(["\x27])(.*?)\1~is', ' src=$1$2$1', $tag, 1);
                }

                $tag = preg_replace('~\s(?:loading|fetchpriority|decoding)=(["\x27]).*?\1~i', '', $tag);
                return preg_replace('~\s*/?>$~', ' loading="eager" fetchpriority="high" decoding="async">', $tag);
            },
            $content
        );
    }

    AddEventHandler('main', 'OnEndBufferContent', 'santehpodborRestorePriorityImages', 20000);
}
