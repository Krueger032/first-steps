        $APPLICATION->SetPageProperty('robots', 'noindex, nofollow');
    }
);

AddEventHandler( "main" ,  "OnPageStart" ,  "santehpodborRedirectDirectFilterAjaxRequest" );
function santehpodborRedirectDirectFilterAjaxRequest () {
   $requestUri  = $_SERVER [ 'REQUEST_URI' ] ?? '';
   $queryString = $_SERVER [ 'QUERY_STRING' ] ?? '';

   if (
      $requestUri === ''
      || strpos( $requestUri, '/filter/' ) === false
      || strpos( $requestUri, '/apply/' ) === false
   ) {
      return;
   }

   $hasAjaxParams = isset( $_REQUEST [ 'AJAX_CALL' ] )
      || isset( $_REQUEST [ 'bxajaxid' ] )
      || stripos( $queryString, 'AJAX_CALL=' ) !== false
      || stripos( $queryString, 'bxajaxid=' ) !== false;

   if ( ! $hasAjaxParams ) {
      return;
   }

   $isXmlHttpRequest = isset( $_SERVER [ 'HTTP_X_REQUESTED_WITH' ] )
      && strtolower( (string) $_SERVER [ 'HTTP_X_REQUESTED_WITH' ] ) === 'xmlhttprequest';

   if ( $isXmlHttpRequest ) {
      return;
   }

   $fetchDest = strtolower( (string) ( $_SERVER [ 'HTTP_SEC_FETCH_DEST' ] ?? '' ) );
   $fetchMode = strtolower( (string) ( $_SERVER [ 'HTTP_SEC_FETCH_MODE' ] ?? '' ) );

   if ( $fetchDest !== '' && $fetchDest !== 'document' ) {
      return;
   }

   if ( $fetchMode !== '' && $fetchMode !== 'navigate' ) {
      return;
   }

   $cleanPath = parse_url( $requestUri, PHP_URL_PATH );
   if ( ! is_string( $cleanPath ) || $cleanPath === '' ) {
      return;
   }

   LocalRedirect( $cleanPath, false, '302 Found' );
}

AddEventHandler( "main" ,  "OnEpilog" ,  "OnABCtoabc" );
function   OnABCtoabc  () { 
   $requestUri  = $_SERVER [ 'REQUEST_URI' ] ?? '';
   $queryString = $_SERVER [ 'QUERY_STRING' ] ?? '';
   $normalizePercentCase = static function (string $value): string {
      return preg_replace_callback(
         '/%[0-9a-f]{2}/i',
         static function (array $match): string {
            return strtoupper( $match [ 0 ] );
         },
         $value
      );
   };
   if (
      isset( $_REQUEST [ 'AJAX_CALL' ] )
      || isset( $_REQUEST [ 'bxajaxid' ] )
      || ( isset( $_REQUEST [ 'ajax' ] ) && strtolower( (string) $_REQUEST [ 'ajax' ] ) === 'y' )
      || stripos( $requestUri, 'AJAX_CALL=' ) !== false
      || stripos( $requestUri, 'bxajaxid=' ) !== false
      || preg_match( '/(^|&)ajax=y(&|$)/i', $queryString )
      || (
         isset( $_SERVER [ 'HTTP_X_REQUESTED_WITH' ] )
         && strtolower( (string) $_SERVER [ 'HTTP_X_REQUESTED_WITH' ] ) === 'xmlhttprequest'
      )
   ) {
      return;
   }

   $notBitrix  = strpos( $_SERVER [ 'REQUEST_URI' ],  '/bitrix/' );
   $haveGet  = strripos( $_SERVER [ 'REQUEST_URI' ],  "?" ) !==  false ;
   if  ( $haveGet ) {
       $url  = explode( "?" ,  $_SERVER [ 'REQUEST_URI' ]);
       if  (( $normalizePercentCase( $_SERVER [ 'REQUEST_URI' ] ) != $normalizePercentCase( strtolower( $url [ 0 ]) .  "?"  .  $url [ 1 ])) &&  $notBitrix  ===  false ) {
          header( 'Location: //'  .  $_SERVER [ 'HTTP_HOST' ] . strtolower( $url [ 0 ]) .  "?"  .  $url [ 1 ],  true ,  301 );
           exit ();
      }
  }  else  {
       if  ( $normalizePercentCase( $_SERVER [ 'REQUEST_URI' ] ) != $normalizePercentCase( strtolower( $_SERVER [ 'REQUEST_URI' ])) &&  $notBitrix  ===  false ) {
          header( 'Location: //'  .  $_SERVER [ 'HTTP_HOST' ] . strtolower( $_SERVER [ 'REQUEST_URI' ]),  true ,  301 );
           exit ();
      }
  }
} 


