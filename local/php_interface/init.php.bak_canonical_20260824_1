function santehpobor_normalize_request_path(string $requestUri): string
{
    $path = parse_url($requestUri, PHP_URL_PATH);
    if ($path === null || $path === '' || $path === false) {
        return '/';
    }
    $path = '/' . trim($path, '/');
    return $path === '//' ? '/' : $path;
}

